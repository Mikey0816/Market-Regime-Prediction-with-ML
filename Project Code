# Section 1 - Downloading yahoo finance data, creating new features, downloading new dataset

# Install packages
import yfinance as yf
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

# Download SPY daily data
df = yf.download("SPY", start="2000-01-01", end="2026-01-01", interval="1d", auto_adjust=False)

# Reset index and flatten columns if yfinance returns a MultiIndex
df = df.reset_index()
if isinstance(df.columns, pd.MultiIndex):
    df.columns = df.columns.get_level_values(0)

# Clean column names
df.columns = [str(col).lower().replace(" ", "_") for col in df.columns]

# Basic return features
df["return_1d"] = df["close"].pct_change()
df["return_5d"] = df["close"].pct_change(5)
df["return_10d"] = df["close"].pct_change(10)
df["return_20d"] = df["close"].pct_change(20)

# Moving averages
df["ma_10"] = df["close"].rolling(10).mean()
df["ma_20"] = df["close"].rolling(20).mean()
df["ma_50"] = df["close"].rolling(50).mean()
df["ma_200"] = df["close"].rolling(200).mean()

# Distance from moving averages
df["dist_ma_50"] = (df["close"] - df["ma_50"]) / df["ma_50"]
df["dist_ma_200"] = (df["close"] - df["ma_200"]) / df["ma_200"]

# Volatility features
df["volatility_10"] = df["return_1d"].rolling(10).std()
df["volatility_20"] = df["return_1d"].rolling(20).std()
df["hl_range"] = (df["high"] - df["low"]) / df["close"]

# Volume features
df["volume_change"] = df["volume"].pct_change()
df["volume_ma_10"] = df["volume"].rolling(10).mean()
df["volume_ratio"] = df["volume"] / df["volume_ma_10"]

# RSI helper
def compute_rsi(series, window=14):
    delta = series.diff()
    gain = delta.clip(lower=0).rolling(window).mean()
    loss = (-delta.clip(upper=0)).rolling(window).mean()
    rs = gain / loss
    return 100 - (100 / (1 + rs))

df["rsi_14"] = compute_rsi(df["close"], 14)

# Bull/Bear regime based on 200-day MA
df["bull_bear_today"] = (df["close"] > df["ma_200"]).astype(int)

# Target = tomorrow's regime
df["target"] = df["bull_bear_today"].shift(-1)

# Drop missing rows created by rolling windows and shifting
df = df.dropna().copy()

# Make sure target is integer after the shift/dropna
df["target"] = df["target"].astype(int)

print(df.head())
print(df.shape)

# Save a CSV copy
csv_name = "spy_dataset2000-2025.csv"
df.to_csv(csv_name, index=False)
print(f"Saved dataset to {csv_name}")

# Download automatically only if running in Google Colab
try:
    from google.colab import files
    files.download(csv_name)
except Exception:
    print("Automatic download skipped because this environment is not Google Colab.")


# Section 2 - Splitting dataset(time-based), scaling features, training and testing logistic regression model

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt

from sklearn.linear_model import LogisticRegression
from sklearn.metrics import accuracy_score, classification_report, confusion_matrix
from sklearn.preprocessing import StandardScaler

# Make a copy
model_df = df.copy()

# Select features
feature_cols = [
    "return_1d",
    "return_5d",
    "return_10d",
    "return_20d",
    "dist_ma_50",
    "dist_ma_200",
    "volatility_10",
    "volatility_20",
    "hl_range",
    "volume_change",
    "volume_ratio",
    "rsi_14"
]

# Keep only needed columns
model_df = model_df[["date", "close", "target"] + feature_cols].dropna().copy()
model_df["target"] = model_df["target"].astype(int)

# Time-based split
split_index = int(len(model_df) * 0.8)

train_df = model_df.iloc[:split_index].copy()
test_df = model_df.iloc[split_index:].copy()

X_train = train_df[feature_cols]
y_train = train_df["target"]

X_test = test_df[feature_cols]
y_test = test_df["target"]

# Scale features
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)

# Train model
model = LogisticRegression(max_iter=1000, random_state=42)
model.fit(X_train_scaled, y_train)

# Predictions
y_pred = model.predict(X_test_scaled)
y_prob = model.predict_proba(X_test_scaled)[:, 1]

# Store predictions
test_df["predicted_regime"] = y_pred
test_df["bull_probability"] = y_prob



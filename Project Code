# Section 8 - Helper functions for final statistics: calculating max drawdown, trading metrics for a specific model, and trading metrics for buy-and-hold strategy

def calculate_max_drawdown(cumulative_returns):
  running_max = cumulative_returns.cummax()
  drawdown = (cumulative_returns / running_max) - 1
  return drawdown.min()

def backtest_strategy(test_data, prediction_col, strategy_name):
  temp = test_data.copy()

  # Daily SPY return
  temp["market_return"] = temp["close"].pct_change().fillna(0)

  # Shift signal by one day to avoid look-ahead bias.
  # The model predicts the next-day regime, but the trading decision should not use future returns.
  temp["strategy_signal"] = temp[prediction_col].shift(1).fillna(0)

  # If signal is 1, hold SPY. If signal is 0, hold cash.
  temp["strategy_return"] = temp["strategy_signal"] * temp["market_return"]

  # Growth of $1
  temp["cumulative_strategy"] = (1 + temp["strategy_return"]).cumprod()

  total_return = temp["cumulative_strategy"].iloc[-1] - 1
  annualized_return = temp["cumulative_strategy"].iloc[-1] ** (252 / len(temp)) - 1
  annualized_volatility = temp["strategy_return"].std() * np.sqrt(252)

  if temp["strategy_return"].std() != 0:
    sharpe_ratio = (temp["strategy_return"].mean() / temp["strategy_return"].std()) * np.sqrt(252)
  else:
    sharpe_ratio = np.nan

  max_drawdown = calculate_max_drawdown(temp["cumulative_strategy"])

  metrics = {
    "Model": strategy_name,
    "Strategy Total Return": total_return,
    "Strategy Annualized Return": annualized_return,
    "Strategy Annualized Volatility": annualized_volatility,
    "Strategy Sharpe Ratio": sharpe_ratio,
    "Strategy Max Drawdown": max_drawdown
  }

  return metrics, temp["cumulative_strategy"]

def buy_and_hold_metrics(test_data):
  temp = test_data.copy()
  temp["market_return"] = temp["close"].pct_change().fillna(0)
  temp["cumulative_market"] = (1 + temp["market_return"]).cumprod()

  total_return = temp["cumulative_market"].iloc[-1] - 1
  annualized_return = temp["cumulative_market"].iloc[-1] ** (252 / len(temp)) - 1
  annualized_volatility = temp["market_return"].std() * np.sqrt(252)

  if temp["market_return"].std() != 0:
    sharpe_ratio = (temp["market_return"].mean() / temp["market_return"].std()) * np.sqrt(252)
  else:
    sharpe_ratio = np.nan

  max_drawdown = calculate_max_drawdown(temp["cumulative_market"])

  metrics = {
    "Model": "Buy-and-Hold SPY",
    "Strategy Total Return": total_return,
    "Strategy Annualized Return": annualized_return,
    "Strategy Annualized Volatility": annualized_volatility,
    "Strategy Sharpe Ratio": sharpe_ratio,
    "Strategy Max Drawdown": max_drawdown
  }

  return metrics, temp["cumulative_market"]



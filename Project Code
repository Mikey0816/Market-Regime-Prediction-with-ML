# Section 4 - Hyperparamter tuning of logistic regression model using pipeline and grid-search cross-validation

from sklearn.pipeline import Pipeline
from sklearn.model_selection import GridSearchCV, TimeSeriesSplit
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import (
    accuracy_score,
    balanced_accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    roc_auc_score,
    classification_report,
    confusion_matrix,
    ConfusionMatrixDisplay,
    RocCurveDisplay
)

tscv = TimeSeriesSplit(n_splits=5)

# Helper function for classification metrics
def get_classification_metrics(model_name, y_true, y_pred, y_prob):
    return {
        "Model": model_name,
        "Accuracy": accuracy_score(y_true, y_pred),
        "Balanced Accuracy": balanced_accuracy_score(y_true, y_pred),
        "Precision": precision_score(y_true, y_pred, zero_division=0),
        "Recall": recall_score(y_true, y_pred, zero_division=0),
        "F1 Score": f1_score(y_true, y_pred, zero_division=0),
        "ROC-AUC": roc_auc_score(y_true, y_prob)
    }

# Save baseline results from the earlier Logistic Regression model
baseline_classification_metrics = get_classification_metrics(
    "Baseline Logistic Regression",
    y_test,
    y_pred,
    y_prob
)

baseline_classification_metrics

# This avoids data leakage during cross-validation.
log_reg_pipeline = Pipeline([
    ("scaler", StandardScaler()),
    ("model", LogisticRegression(max_iter=5000, random_state=42))
])

# Use compatible Logistic Regression settings.
# We avoid incompatible solver/penalty combinations.
log_reg_param_grid = {
    "model__C": [0.001, 0.01, 0.1, 1, 10, 100],
    "model__penalty": ["l2"],
    "model__solver": ["lbfgs"],
    "model__class_weight": [None, "balanced"]
}

log_reg_grid = GridSearchCV(
    estimator=log_reg_pipeline,
    param_grid=log_reg_param_grid,
    cv=tscv,
    scoring="roc_auc",
    n_jobs=-1,
    verbose=1
)

# Use unscaled X_train here because the pipeline handles scaling internally.
log_reg_grid.fit(X_train, y_train)

best_log_reg = log_reg_grid.best_estimator_

# Final test-set predictions
y_pred_log_reg_tuned = best_log_reg.predict(X_test)
y_prob_log_reg_tuned = best_log_reg.predict_proba(X_test)[:, 1]

print("Best Logistic Regression Parameters:")
print(log_reg_grid.best_params_)

print("\nBest Cross-Validation ROC-AUC:")
print(log_reg_grid.best_score_)


# Section 5 - Displaying metrics and graphs for tuned logistic regression model

# Classification Report and Metrics for Tuned Logistic Regression

print("\nTuned Logistic Regression Test Classification Report:")
print(classification_report(y_test, y_pred_log_reg_tuned))

log_reg_tuned_classification_metrics = get_classification_metrics(
    "Tuned Logistic Regression",
    y_test,
    y_pred_log_reg_tuned,
    y_prob_log_reg_tuned
)

log_reg_tuned_classification_metrics

# Confusion Matrix and ROC Curve for Tuned Logistic Regression
